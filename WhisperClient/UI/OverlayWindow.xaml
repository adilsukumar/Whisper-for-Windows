<Window x:Class="WhisperClient.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowState="Normal"
        ShowActivated="False"
        Width="1" Height="1"
        ResizeMode="NoResize">

    <Canvas x:Name="OverlayCanvas" ClipToBounds="False">

        <!-- The Blob Companion -->
        <Canvas x:Name="BlobContainer" Canvas.Left="0" Canvas.Top="0">
            <!-- Outer glow (visible when listening) -->
            <Ellipse x:Name="BlobGlow" Width="60" Height="60"
                     Canvas.Left="-10" Canvas.Top="-10"
                     Opacity="0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6640A9FF" Offset="0"/>
                        <GradientStop Color="#0040A9FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Main blob body -->
            <Ellipse x:Name="BlobBody" Width="40" Height="40">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF3A3A4A" Offset="0"/>
                        <GradientStop Color="#FF1E1E2E" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Ellipse.Effect>
            </Ellipse>

            <!-- Inner eye/dot (shows state) -->
            <Ellipse x:Name="BlobEye" Width="8" Height="8"
                     Canvas.Left="16" Canvas.Top="16"
                     Fill="#FF6E6E8A"/>
        </Canvas>

        <!-- Response Text Bubble -->
        <Border x:Name="ResponseBubble"
                Canvas.Left="0" Canvas.Top="0"
                Background="#F0202030"
                CornerRadius="12"
                Padding="14,10"
                MaxWidth="400"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.4"/>
            </Border.Effect>
            <TextBlock x:Name="ResponseText"
                       Foreground="#FFE0E0E8"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       TextWrapping="Wrap"
                       MaxWidth="370"/>
        </Border>

        <!-- Status indicator text -->
        <TextBlock x:Name="StatusText"
                   Canvas.Left="0" Canvas.Top="0"
                   Foreground="#8840A9FF"
                   FontFamily="Segoe UI"
                   FontSize="10"
                   Visibility="Collapsed"/>

    </Canvas>
</Window>
