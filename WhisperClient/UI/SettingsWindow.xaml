<Window x:Class="WhisperClient.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Whisper settings" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#FF202030" Foreground="White">
    <StackPanel Margin="22">
        <TextBlock Text="Whisper settings" FontSize="22" Margin="0,0,0,14"/>
        <TextBlock Text="AI inference is local. Paid-release builds contact the account service to verify access; no audio or screenshots are sent there."
                   TextWrapping="Wrap" Foreground="#FFB8B8C8" Margin="0,0,0,16"/>
        <CheckBox x:Name="SpeakResponses" Content="Speak completed answers" Foreground="White" Margin="0,0,0,12"/>
        <CheckBox x:Name="VoiceScreen" Content="Include the monitor where I start voice input" Foreground="White" Margin="0,0,0,6"/>
        <TextBlock Text="Off by default. When enabled, voice questions capture the cursor's monitor at the start of the question, not every display."
                   TextWrapping="Wrap" Foreground="#FFB8B8C8" Margin="20,0,0,14"/>
        <CheckBox x:Name="ReducedMotion" Content="Reduce companion animation" Foreground="White" Margin="0,0,0,14"/>
        <TextBlock Text="Text questions never include a screenshot unless you check the screen-sharing option in that question window."
                   TextWrapping="Wrap" Foreground="#FFB8B8C8" Margin="0,0,0,12"/>
        <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#FFFFCC80" Margin="0,0,0,12"/>
        <Button x:Name="CheckRuntime" Content="Check local runtime (no downloads)" Click="OnCheckRuntime" Margin="0,0,0,8"/>
        <TextBlock x:Name="RuntimeStatus" Text="Runtime has not been checked." TextWrapping="Wrap" Foreground="#FFB8B8C8" Margin="0,0,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="85" Margin="0,0,10,0" IsCancel="True" Click="OnCancel"/>
            <Button Content="Save" Width="85" IsDefault="True" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
