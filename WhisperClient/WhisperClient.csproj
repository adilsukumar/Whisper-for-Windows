<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WhisperClient</RootNamespace>
    <AssemblyName>Whisper</AssemblyName>
    <ApplicationIcon></ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WhisperPaidRelease)' == 'true'">
    <DefineConstants>$(DefineConstants);WHISPER_PAID_RELEASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WhisperPaidRelease)' == 'true'">
    <AssemblyMetadata Include="WhisperAccountsOrigin" Value="$(WhisperAccountsOrigin)" />
  </ItemGroup>
  <Target Name="RequirePaidReleaseOrigin" BeforeTargets="BeforeBuild" Condition="'$(WhisperPaidRelease)' == 'true'">
    <Error Condition="'$(WhisperAccountsOrigin)' == ''" Text="Paid releases require WhisperAccountsOrigin. Do not publish a developer build as paid." />
  </Target>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
